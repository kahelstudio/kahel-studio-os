KAHEL_STAFF_EMAIL=owner@example.com
# Comma-separated staff email allowlist. @kahelstudio.com domain users use their actual work emails.
# Additional staff with Gmail must use the format: firstname.kahelstudio@gmail.com
# Gmail users matching *.kahelstudio@gmail.com are automatically accepted without being listed here.
KAHEL_STAFF_EMAILS=owner@kahelstudio.com,staff@kahelstudio.com
# Local development only. Remove or set false before deployment.
KAHEL_AUTH_DISABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
AUTH_REDIRECT_URL=http://localhost:3000/reset-password
CUSTOMER_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
PUBLIC_SITE_URL=http://localhost:3000
BOOKING_EMAIL_FROM=bookings@example.com
SUPABASE_AUTH_EMAIL_FROM=auth@example.com
BOOKING_EMAIL_REPLY_TO=hello@example.com
RESEND_API_KEY=re_replace_me
# Resend webhook signing secret for /api/resend/webhook (Svix whsec_ value).
RESEND_WEBHOOK_SECRET=whsec_replace_me
# Independent bearer secret for scheduled POST /api/email/queue/process calls.
EMAIL_QUEUE_SECRET=replace-with-a-long-random-secret
TURNSTILE_SECRET=replace-with-your-private-secret-key
GOOGLE_AUTH_ENABLED=false
# Server-only PayMongo test secret. Never prefix this variable with NEXT_PUBLIC_.
PAYMONGO_SECRET_KEY=sk_test_replace_me
# Add billease only after PayMongo activates it for this environment's merchant account.
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,grab_pay,qrph
PAYMONGO_BNPL_ENABLED=false
# Signing secret returned when this exact webhook endpoint is created.
PAYMONGO_WEBHOOK_SECRET=whsk_replace_me
