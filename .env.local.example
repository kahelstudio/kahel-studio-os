# Local development environment — copy to .env.local and adjust as needed.
# Run `npm run db:start` first, then `npm run db:reset` to apply migrations and seed data.
#
# Keys below are the well-known local Supabase defaults (safe for local dev only).
# If they differ from your `supabase status` output, use the values from that command.

KAHEL_STAFF_EMAIL=owner@kahelstudio.com
# Your own @kahelstudio.com or firstname.kahelstudio@gmail.com address is accepted automatically.
# Add any extra staff addresses as a comma-separated list.
KAHEL_STAFF_EMAILS=owner@kahelstudio.com,staff@kahelstudio.com
# Skip staff email/password login when true. Safe for local dev; never set in production.
KAHEL_AUTH_DISABLED=false

# ── Supabase local dev ──────────────────────────────────────────────────────
# These keys are generated by the Supabase CLI and are safe for local dev only.
# Run `supabase status` (or `npm run db:status`) to confirm yours match.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7urOoD9bje4iLvrfyY0hGHocMv68u-74yiI
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ── Auth URLs ───────────────────────────────────────────────────────────────
AUTH_REDIRECT_URL=https://localhost:3000/reset-password
CUSTOMER_AUTH_CALLBACK_URL=https://localhost:3000/auth/callback
PUBLIC_SITE_URL=https://localhost:3000

# ── Email (outbound via Resend) ─────────────────────────────────────────────
BOOKING_EMAIL_FROM=bookings@example.com
SUPABASE_AUTH_EMAIL_FROM=auth@example.com
BOOKING_EMAIL_REPLY_TO=hello@example.com
# Get a free test key from resend.com, or leave placeholder to skip real sending.
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
EMAIL_QUEUE_SECRET=replace-with-a-long-random-secret

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
# Use the always-pass test secret: https://developers.cloudflare.com/turnstile/reference/testing/
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-replace_me

# ── PayMongo ────────────────────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,grab_pay,qrph,billease
PAYMONGO_BNPL_ENABLED=true
PAYMONGO_WEBHOOK_SECRET=whsk_replace_me
